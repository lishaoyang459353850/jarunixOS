# jarunixOS 1.0 个人版包清单（Debian 13 trixie，amd64）
# 已通过 QEMU 实机启动验证的软件集合：Java 运行库 + Xorg + openbox + Java 桌面外壳 + 图形化安装器
#
# 注：本清单通过 mmdebstrap 的 --include= 传入（逗号分隔），构建脚本会读取本文件。

# --- 内核与 initramfs ---
linux-image-amd64
initramfs-tools
firmware-linux-free

# --- Live 系统支持 ---
live-boot
live-config
live-config-systemd
systemd-sysv
dbus
dbus-x11

# --- 本地化 ---
locales
console-setup
keyboard-configuration
tzdata

# --- 基础工具 ---
ca-certificates
sudo
less
nano
rsync
xz-utils
zstd
bzip2
unzip
file
procps
psmisc

# --- 硬件与网络 ---
pciutils
usbutils
iproute2
isc-dhcp-client
wpasupplicant
net-tools
iw
rfkill

# --- 图形栈：Xorg + openbox ---
xserver-xorg-core
xserver-xorg-video-vesa
xserver-xorg-video-fbdev
xserver-xorg-input-libinput
xinit
xauth
x11-utils
x11-xserver-utils
x11-xkb-utils
xkb-data
xterm
openbox
fonts-dejavu-core
fonts-wqy-zenhei

# --- Java 运行库（系统核心）---
openjdk-21-jre

# --- 安装器后端依赖 ---
parted
gdisk
dosfstools
e2fsprogs
grub-pc-bin
grub-efi-amd64-bin
grub-common
os-prober
squashfs-tools
